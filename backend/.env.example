PORT=4000
JWT_SECRET=bunu-uzun-rastgele-bir-degerle-degistirin
# SQLite dosya yolu
DB_PATH=./data/app.db
# Veritabanı boşsa örnek ilanları ekle (geliştirme için)
SEED_SAMPLE=true
# Scraper zamanlaması (cron) – varsayılan: her 3 saatte bir
SCRAPE_CRON=0 */3 * * *
SCRAPE_ON_START=false
# POST /api/admin/scrape için x-admin-key başlığı
ADMIN_KEY=
# Bildirim gönderilecek minimum eşleşme puanı (0-100)
NOTIFY_MIN_SCORE=50
# (opsiyonel) Expo push erişim token'ı
EXPO_ACCESS_TOKEN=
